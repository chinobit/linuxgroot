// wrangler.jsonc - Cloudflare Workers Static Assets, linuxgroot.net
//
// Dependency chain:
//   "name" matches the existing Worker "linuxgroot" -> `wrangler deploy` REPLACES the
//   old geolocation placeholder in-place (no orphaned Worker). "assets.directory"
//   consumes Zola's build output (public/), which includes static/_headers for
//   HTTP-header security policies. No "main": assets-only Worker, zero server code.
//   Deployed by cloudflare/wrangler-action in .github/workflows/deploy.yml using a
//   least-privilege API token (Workers Scripts:Edit only).
{
    "name": "linuxgroot",
    "compatibility_date": "2026-08-01",
    "assets": {
        "directory": "./public",
        // Zola builds public/404.html, but Workers Static Assets defaults
        // not_found_handling to "none", which answers an unknown path with a bare
        // empty 404 and never reaches the styled page. Verified against the live site
        // before this line existed: the response body was zero bytes.
        // Not "single-page-application": that would answer every unknown path with
        // 200, which is wrong for a static site and bad for search engines.
        "not_found_handling": "404-page"
    },
    "routes": [
        { "pattern": "linuxgroot.net", "custom_domain": true }
    ]
}
